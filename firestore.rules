rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Polls are public by code, but clients cannot enumerate or modify them.
    match /polls/{code} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if false;

      // Vote records are private server-side evidence used to enforce one vote per UID.
      match /votes/{uid} {
        allow read, write: if false;
      }
    }

    // Every other client operation is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
